# Copy to .streamlit/secrets.toml (never commit the real file) to enable the AI assistant.
ANTHROPIC_API_KEY = "sk-ant-..."

# Single sign-on (OIDC) with your company identity provider (Microsoft Entra ID, Okta, Google Workspace...).
# Then set SHIFTSENSE_AUTH=sso (company accounts only; SHIFTSENSE_BREAKGLASS=admin keeps one emergency password
# account) or SHIFTSENSE_AUTH=both. Register the redirect URI below with the provider.
# A person gets in only if an ACTIVE ShiftSense account has the same email; the role comes from ShiftSense.
[auth]
redirect_uri = "https://shiftsense.example.com/oauth2callback"
cookie_secret = "a-long-random-string"
client_id = "..."
client_secret = "..."
server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"
