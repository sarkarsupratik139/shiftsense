# Copy to .env (git-ignored) and fill in. Readable by the operators only.
SHIFTSENSE_ENV=pilot
SHIFTSENSE_DOMAIN=shiftsense.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Sign-in: sso (company accounts only) | both | password. With sso, keep one emergency admin password account:
SHIFTSENSE_AUTH=both
SHIFTSENSE_BREAKGLASS=admin
SHIFTSENSE_IDLE_MINUTES=30
SHIFTSENSE_LOCKOUT_ATTEMPTS=5
SHIFTSENSE_LOCKOUT_MINUTES=15
# Optional email copies and health alerts
SHIFTSENSE_EMAIL=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SHIFTSENSE_EMAIL_FROM=shiftsense@example.com
SHIFTSENSE_ALERT_EMAIL=ops-oncall@example.com
# Optional AI explanations (never decisions); leave empty for rule-based only
ANTHROPIC_API_KEY=
